---
import Base from '@/layouts/Base.astro';
import { getEntry } from 'astro:content';
import { DownloadButtons } from '@/components/DownloadButtons';
import { ResumeLayout } from '@/components/ResumeLayout';

const entry = await getEntry('resume', 'alex');
const resume = entry?.data;

if (!resume) {
  return Astro.redirect('/');
}
---

<Base title="Commercial Work Experience — Alex Alexandrescu">
  <div class="max-w-5xl mx-auto px-6 lg:px-8 pt-16">
    <header class="mb-8" transition:name="page-header">
      <p class="text-xs uppercase tracking-[0.3em] text-primary mb-2">Resume</p>
      <h1 class="text-4xl md:text-5xl font-serif text-foreground text-balance">Commercial Work Experience</h1>
      <p class="font-serif text-muted-foreground mt-3 italic">
        Roles, responsibilities, and impact across my career.
      </p>
    </header>
  </div>

  <div class="relative">
    <ResumeLayout resume={resume} client:load />
    <DownloadButtons resume={resume} alignment="left" client:load />
  </div>
</Base>
