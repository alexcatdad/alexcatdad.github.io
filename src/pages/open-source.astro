---
import Base from '@/layouts/Base.astro';
import { featuredProjects } from '@/data/featured-projects';
import type { FeaturedProject } from '@/data/featured-projects';

interface RepoStats {
  stars: number;
  pushedAt: string;
}

async function fetchRepoStats(fullName: string): Promise<RepoStats | null> {
  const token = import.meta.env.GITHUB_TOKEN ?? process.env.GITHUB_TOKEN;
  const headers: Record<string, string> = {
    Accept: 'application/vnd.github+json',
  };
  if (token) headers.Authorization = `Bearer ${token}`;

  try {
    const res = await fetch(`https://api.github.com/repos/${fullName}`, {
      headers,
    });
    if (!res.ok) return null;
    const data = await res.json();
    return { stars: data.stargazers_count ?? 0, pushedAt: data.pushed_at ?? '' };
  } catch {
    return null;
  }
}

function daysSince(iso: string): number {
  if (!iso) return -1;
  const diff = Date.now() - new Date(iso).getTime();
  return Math.floor(diff / (1000 * 60 * 60 * 24));
}

function formatRecency(days: number): string {
  if (days < 0) return '';
  if (days === 0) return 'today';
  if (days === 1) return 'yesterday';
  if (days < 7) return `${days}d ago`;
  if (days < 30) return `${Math.floor(days / 7)}w ago`;
  if (days < 365) return `${Math.floor(days / 30)}mo ago`;
  return `${Math.floor(days / 365)}y ago`;
}

// Fetch live stats for all repos across all projects
const statsMap = new Map<string, RepoStats>();
const fetches = featuredProjects.flatMap((p) => p.repos);
const results = await Promise.all(fetches.map(fetchRepoStats));
fetches.forEach((repo, i) => {
  if (results[i]) statsMap.set(repo, results[i]);
});

// Compute aggregate stats per project
function getProjectStats(project: FeaturedProject) {
  let totalStars = 0;
  let latestPush = '';
  for (const repo of project.repos) {
    const stats = statsMap.get(repo);
    if (stats) {
      totalStars += stats.stars;
      if (!latestPush || stats.pushedAt > latestPush) latestPush = stats.pushedAt;
    }
  }
  return { totalStars, recency: formatRecency(daysSince(latestPush)) };
}
---

<Base title="Open Source — Alex Alexandrescu" description="Featured open-source projects">
  <div class="max-w-3xl mx-auto px-6 lg:px-8 py-16">
    <header class="mb-14" transition:name="page-header">
      <p class="text-xs uppercase tracking-[0.3em] text-primary mb-2 fade-in" style="--delay: 0.1s">Featured Projects</p>
      <h1 class="text-4xl md:text-5xl font-serif text-foreground text-balance fade-in" style="--delay: 0.2s">Open Source</h1>
      <p class="font-serif text-muted-foreground mt-3 max-w-lg fade-in" style="--delay: 0.35s">
        A handful of tools I built and use regularly. Each one started as a personal itch.
      </p>
    </header>

    <div class="space-y-8">
      {featuredProjects.map((project, i) => {
        const { totalStars, recency } = getProjectStats(project);
        return (
          <article
            data-project-card
            class:list={[
              'interactive-card rounded-2xl border border-border bg-card/50 shadow-apple-lg',
              'p-6 md:p-8',
              'fade-in',
            ]}
            style={`--delay: ${0.4 + i * 0.15}s`}
          >
            {/* Hero screenshot */}
            <div class="overflow-hidden rounded-xl border border-border mb-5 md:mb-6">
              <img
                src={project.hero}
                alt={`${project.name} screenshot`}
                width="720"
                height="400"
                loading="lazy"
                class="w-full h-auto object-cover"
              />
            </div>

            {/* Header: name + language */}
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-2xl md:text-3xl font-serif text-foreground">
                  {project.name}
                </h2>
                <p class="text-sm text-muted-foreground mt-1">{project.tagline}</p>
              </div>
              <span class="flex items-center gap-1.5 text-xs text-muted-foreground mt-1.5 shrink-0">
                <span class={`inline-block w-2.5 h-2.5 rounded-full ${project.languageColor}`} />
                {project.language}
              </span>
            </div>

            {/* Divider */}
            <div class="border-t border-border my-5 md:my-6" />

            {/* What & Why */}
            <div class="grid gap-5 md:grid-cols-2">
              <div>
                <p class="text-xs uppercase tracking-[0.2em] text-primary mb-2">What</p>
                <p class="font-serif text-foreground/90 text-[0.95rem] leading-relaxed">
                  {project.what}
                </p>
              </div>
              <div>
                <p class="text-xs uppercase tracking-[0.2em] text-primary mb-2">Why</p>
                <p class="font-serif text-foreground/90 text-[0.95rem] leading-relaxed">
                  {project.why}
                </p>
              </div>
            </div>

            {/* Tags */}
            <div class="mt-5 md:mt-6 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="text-xs border border-border rounded-full px-2.5 py-0.5 text-muted-foreground">
                  {tag}
                </span>
              ))}
            </div>

            {/* Footer: stats + links */}
            <div class="mt-5 md:mt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <div class="flex items-center gap-3 text-xs text-muted-foreground">
                {totalStars > 0 && (
                  <span class="flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="currentColor"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25z" /></svg>
                    {totalStars}
                  </span>
                )}
                {recency && <span>updated {recency}</span>}
              </div>
              <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
                {project.links.map((link) => (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-pulse text-sm text-foreground"
                  >
                    {link.label} <span aria-hidden="true">&#8599;</span>
                  </a>
                ))}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {/* Homebrew tap callout */}
    <aside class="mt-12 rounded-2xl border border-border bg-card/30 p-6 md:p-8 fade-in" style="--delay: 0.85s">
      <p class="text-xs uppercase tracking-[0.2em] text-primary mb-3">Install via Homebrew</p>
      <p class="font-serif text-foreground/90 text-[0.95rem] leading-relaxed mb-4">
        Both <strong>paw</strong> and <strong>paw-proxy</strong> are distributed through a personal Homebrew tap. One command to add the tap, then install either tool.
      </p>
      <div class="rounded-lg bg-secondary/50 border border-border p-4 font-mono text-sm text-foreground/80 space-y-1">
        <p><span class="text-muted-foreground">$</span> brew tap alexcatdad/tap</p>
        <p><span class="text-muted-foreground">$</span> brew install paw</p>
        <p><span class="text-muted-foreground">$</span> brew install paw-proxy</p>
      </div>
      <div class="mt-4 flex items-center justify-between">
        <span class="text-xs text-muted-foreground">paw v0.4.0 · paw-proxy v1.9.0</span>
        <a
          href="https://github.com/alexcatdad/homebrew-tap"
          target="_blank"
          rel="noopener noreferrer"
          class="link-pulse text-sm text-foreground"
        >
          View tap <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </aside>
  </div>
</Base>
