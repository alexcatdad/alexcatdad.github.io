---
import Base from '@/layouts/Base.astro';
import { getEntry } from 'astro:content';
import ContactReveal from '@/components/ContactReveal.astro';

const entry = await getEntry('resume', 'alex');
const resume = entry?.data;
const basics = resume?.basics;

const location = basics?.location
  ? `${basics.location.city || ''}${basics.location.city && basics.location.countryCode ? ', ' : ''}${basics.location.countryCode || ''}`
  : '';
---

<Base title="Contact — Alex Alexandrescu" description="Get in touch with Alex Alexandrescu">
  <div class="max-w-3xl mx-auto px-6 lg:px-8 py-16">
    <header class="mb-12">
      <p class="text-xs uppercase tracking-[0.3em] text-primary mb-2">Get in touch</p>
      <h1 class="text-4xl md:text-5xl font-serif text-foreground">Contact</h1>
    </header>

    <div class="border-t border-border">
      {/* Email */}
      {basics?.email && (
        <div class="py-8 border-b border-border">
          <p class="text-xs uppercase tracking-[0.3em] text-muted-foreground mb-3">Email</p>
          <ContactReveal email={basics.email} />
        </div>
      )}

      {/* Location */}
      {location && (
        <div class="py-8 border-b border-border">
          <p class="text-xs uppercase tracking-[0.3em] text-muted-foreground mb-3">Location</p>
          <p class="font-serif text-lg text-foreground">{location}</p>
        </div>
      )}

      {/* Profiles */}
      {basics?.profiles && basics.profiles.length > 0 && (
        <div class="py-8 border-b border-border">
          <p class="text-xs uppercase tracking-[0.3em] text-muted-foreground mb-4">Profiles</p>
          <div class="flex flex-wrap gap-4">
            {basics.profiles.map((profile) => (
              <a
                href={profile.url}
                target="_blank"
                rel="noopener noreferrer"
                class="link-pulse text-foreground font-serif text-lg hover:text-primary"
              >
                {profile.network}
                <span class="text-sm ml-1">&#8599;</span>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </div>
</Base>
