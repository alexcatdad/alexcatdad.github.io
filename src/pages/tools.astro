---
import Base from '@/layouts/Base.astro';
import toolsData from '@/content/tools/tools.json';

interface ToolItem {
  name: string;
  kind: string;
  url: string;
  why: string;
}

interface ToolSection {
  title: string;
  description: string;
  items: ToolItem[];
}

const sections = (toolsData as { sections: ToolSection[] }).sections;
---

<Base title="Tools — Alex Alexandrescu" description="Preferred stack and built tools">
  <div class="max-w-5xl mx-auto px-6 lg:px-8 py-16">
    <header class="mb-12">
      <p class="text-xs uppercase tracking-[0.3em] text-primary mb-2">Stack</p>
      <h1 class="text-4xl md:text-5xl font-serif text-foreground">My tools of choice</h1>
      <p class="font-serif text-muted-foreground mt-3 italic">
        The runtime, frameworks, and custom tooling I actually use to ship.
      </p>
    </header>

    <div class="space-y-8">
      {sections.map((section) => (
        <section class="interactive-card rounded-3xl border border-border bg-card/50 p-6 shadow-apple">
          <h2 class="text-2xl font-serif text-foreground">{section.title}</h2>
          <p class="mt-2 text-sm text-muted-foreground">{section.description}</p>

          <div class="mt-5 grid gap-4 md:grid-cols-2">
            {section.items.map((item) => (
              <article class="rounded-2xl border border-border bg-secondary/30 p-4">
                <div class="flex items-center justify-between gap-3">
                  <h3 class="text-lg font-semibold text-foreground">{item.name}</h3>
                  <span class="text-[10px] uppercase tracking-[0.2em] text-primary">{item.kind}</span>
                </div>
                <p class="mt-2 text-sm text-muted-foreground">{item.why}</p>
                <a href={item.url} target="_blank" rel="noopener noreferrer" class="link-pulse mt-3 text-sm text-foreground">
                  Visit <span aria-hidden="true">↗</span>
                </a>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>
