---
import Base from '@/layouts/Base.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
---

<Base
  title="I'm bored — Alex Alexandrescu"
  description="Text roguelite for tab-side fun"
  hideNav={true}
  hideFooter={true}
  hideWelcomeToast={true}
  mainClass="h-screen"
>
  <div id="dungeon-root" class="dungeon-shell">
    <!-- ═══ TOP BAR: vital gauges + compact stats ═══ -->
    <header class="dungeon-header">
      <div class="dungeon-header__top">
        <div class="dungeon-header__brand">
          <h1 class="dungeon-header__title">bored</h1>
        </div>
        <div class="dungeon-stats">
          <span class="dungeon-chip" title="Depth"><span class="dungeon-chip__k">D</span><span id="stat-depth" class="dungeon-chip__v">0</span></span>
          <span class="dungeon-chip" title="Attack"><span class="dungeon-chip__k">ATK</span><span id="stat-atk" class="dungeon-chip__v">0</span></span>
          <span class="dungeon-chip" title="Guard"><span class="dungeon-chip__k">GRD</span><span id="stat-guard" class="dungeon-chip__v">0</span></span>
          <span class="dungeon-chip" title="Luck"><span class="dungeon-chip__k">LCK</span><span id="stat-luck" class="dungeon-chip__v">0</span></span>
          <span class="dungeon-chip" title="Gold"><span class="dungeon-chip__k">&#9733;</span><span id="stat-gold" class="dungeon-chip__v">0</span></span>
          <span class="dungeon-chip dungeon-chip--accent" title="Goal"><span id="stat-goal" class="dungeon-chip__v">Depth 9</span></span>
          <span class="dungeon-chip" title="Relic"><span class="dungeon-chip__k">Relic</span><span id="stat-relic" class="dungeon-chip__v">---</span></span>
        </div>
        <div class="dungeon-header__actions">
          <ThemeToggle />
          <a href="/" class="dungeon-btn dungeon-btn--ghost">&lt; Exit</a>
        </div>
      </div>

      <!-- Vital bars -->
      <div class="dungeon-vitals">
        <div class="dungeon-bar dungeon-bar--timer" title="Time remaining">
          <div class="dungeon-bar__label">
            <span class="dungeon-bar__icon">&#9201;</span>
            <span id="stat-time" class="dungeon-bar__value">60.0</span><span class="dungeon-bar__unit">s</span>
          </div>
          <div class="dungeon-bar__track">
            <div id="bar-time-fill" class="dungeon-bar__fill dungeon-bar__fill--timer" style="width:100%"></div>
          </div>
        </div>
        <div class="dungeon-bar dungeon-bar--hp" title="Hit points">
          <div class="dungeon-bar__label">
            <span class="dungeon-bar__icon">&#9829;</span>
            <span id="stat-hp" class="dungeon-bar__value">0</span>
          </div>
          <div class="dungeon-bar__track">
            <div id="bar-hp-fill" class="dungeon-bar__fill dungeon-bar__fill--hp" style="width:100%"></div>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══ MIDDLE: encounter + log ═══ -->
    <div class="dungeon-stage">
      <!-- Room encounter card -->
      <div class="dungeon-encounter">
        <div class="dungeon-encounter__header">
          <h2 id="room-title" class="dungeon-encounter__title">Ready for a run</h2>
          <p id="room-intent" class="dungeon-encounter__intent"></p>
        </div>
        <p id="room-description" class="dungeon-encounter__desc">Press start to enter the dungeon. Each action spends its listed seconds. Reach depth 9 before time hits zero for a win.</p>
        <p id="room-mission" class="dungeon-encounter__mission"></p>
        <p id="room-risk" class="dungeon-encounter__risk"></p>
        <pre
          id="transition-ascii"
          class="dungeon-transition hidden"
        ></pre>
        <!-- Collapsed quest brief -->
        <div class="dungeon-quest-brief">
          <p id="quest-role" class="dungeon-quest-brief__line">You are Nyx, the Lantern Courier.</p>
          <p id="quest-motivation" class="dungeon-quest-brief__line hidden">Motivation: steal the Dawn Relic and prove this run still matters.</p>
          <p id="quest-objective" class="dungeon-quest-brief__line">Objective: reach depth 9 before your 60 seconds are spent.</p>
        </div>
      </div>

      <!-- Compact event log -->
      <div id="event-log-viewport" class="dungeon-log">
        <ul id="event-log" class="dungeon-log__list"></ul>
      </div>

      <!-- Run summary (shown during run) -->
      <div id="run-summary" class="dungeon-summary">
        No run yet. Spend shards on upgrades, then start a run.
      </div>
    </div>

    <!-- ═══ BOTTOM: choices + controls ═══ -->
    <footer class="dungeon-controls">
      <!-- Choice cards — THE core interaction -->
      <div id="choice-list" class="dungeon-choices"></div>

      <!-- Action buttons -->
      <div class="dungeon-actions">
        <button id="action-start-run" class="dungeon-btn dungeon-btn--primary dungeon-btn--start">
          <span class="dungeon-btn__text">&gt; Start run</span>
          <kbd class="dungeon-kbd">S</kbd>
        </button>
        <button id="action-restart-run" class="dungeon-btn dungeon-btn--secondary">
          <span class="dungeon-btn__text">Restart</span>
        </button>
        <button id="action-abandon-run" class="dungeon-btn dungeon-btn--danger">
          <span class="dungeon-btn__text">Abandon</span>
        </button>
        <button id="action-reset" class="dungeon-btn dungeon-btn--ghost dungeon-btn--sm">
          <span class="dungeon-btn__text">Reset all</span>
        </button>
      </div>

      <!-- Mobile sidebar toggle -->
      <button
        id="sidebar-toggle"
        class="dungeon-btn dungeon-btn--ghost dungeon-sidebar-trigger lg:hidden"
      >
        Loadout &amp; Upgrades
      </button>
    </footer>

    <!-- ═══ SIDEBAR (drawer on mobile, pinned on desktop) ═══ -->
    <aside
      id="sidebar-panel"
      class="dungeon-sidebar hidden lg:flex"
    >
      <div class="dungeon-sidebar__inner">
        <div class="dungeon-sidebar__head">
          <h2 class="dungeon-sidebar__title">Loadout</h2>
          <button id="sidebar-close" class="dungeon-btn dungeon-btn--ghost dungeon-btn--sm lg:hidden">Close</button>
        </div>

        <!-- Meta -->
        <article class="dungeon-card">
          <h3 class="dungeon-card__heading">Meta</h3>
          <label class="dungeon-label" for="meta-alias">Alias</label>
          <input id="meta-alias" class="dungeon-input" maxlength="18" />
          <div class="dungeon-meta-grid">
            <div class="dungeon-meta-stat"><span class="dungeon-meta-stat__k">Shards</span><span id="meta-shards" class="dungeon-meta-stat__v">0</span></div>
            <div class="dungeon-meta-stat"><span class="dungeon-meta-stat__k">Runs</span><span id="meta-runs" class="dungeon-meta-stat__v">0</span></div>
            <div class="dungeon-meta-stat"><span class="dungeon-meta-stat__k">Wins</span><span id="meta-wins" class="dungeon-meta-stat__v">0</span></div>
            <div class="dungeon-meta-stat"><span class="dungeon-meta-stat__k">Best</span><span id="meta-best-depth" class="dungeon-meta-stat__v">0</span></div>
          </div>
        </article>

        <!-- Inventory -->
        <article class="dungeon-card">
          <h3 class="dungeon-card__heading">Inventory</h3>
          <div class="dungeon-inv-section">
            <p class="dungeon-inv-label">Collectibles</p>
            <ul id="inventory-collectibles" class="dungeon-inv-list"></ul>
          </div>
          <div class="dungeon-inv-section">
            <p class="dungeon-inv-label">Consumables</p>
            <ul id="inventory-consumables" class="dungeon-inv-list"></ul>
          </div>
          <div class="dungeon-inv-section">
            <p class="dungeon-inv-label">Debuffs</p>
            <ul id="inventory-debuffs" class="dungeon-inv-list"></ul>
          </div>
        </article>

        <!-- Upgrades -->
        <article class="dungeon-card">
          <h3 class="dungeon-card__heading">Shard Upgrades</h3>
          <div id="upgrade-list" class="dungeon-upgrade-list"></div>
        </article>

        <!-- Leaderboard -->
        <article class="dungeon-card">
          <div class="dungeon-card__heading-row">
            <h3 class="dungeon-card__heading">Leaderboard</h3>
            <span id="leaderboard-status" class="dungeon-card__badge">Local IndexedDB</span>
          </div>
          <ul id="leaderboard-list" class="dungeon-lb-list"></ul>
        </article>

        <!-- Telemetry -->
        <article class="dungeon-card">
          <div class="dungeon-card__heading-row">
            <h3 class="dungeon-card__heading">Telemetry</h3>
            <button id="telemetry-reset" class="dungeon-btn dungeon-btn--ghost dungeon-btn--xs">Reset</button>
          </div>
          <div id="telemetry-summary" class="dungeon-telemetry"></div>
        </article>
      </div>
    </aside>

    <!-- ═══ RECAP OVERLAY (modal after run ends) ═══ -->
    <div id="recap-panel" class="dungeon-recap-overlay hidden">
      <div class="dungeon-recap-overlay__backdrop"></div>
      <div class="dungeon-recap-overlay__card">
        <p id="recap-title" class="dungeon-recap-overlay__title">Run recap</p>
        <ul id="recap-list" class="dungeon-recap-overlay__list"></ul>
        <button class="dungeon-btn dungeon-btn--primary dungeon-recap-overlay__dismiss">&gt; Continue</button>
      </div>
    </div>
  </div>

  <style is:global>
    /* ═══════════════════════════════════════
       BORED DUNGEON — terminal roguelite UI
       ═══════════════════════════════════════ */

    .dungeon-shell {
      /* Game-only colors with no design token match */
      --dungeon-hp: #4a8a4a;
      --dungeon-safe: #5a9a5a;
      --dungeon-safe-fg: #8aba8a;
      --dungeon-combat-fg: color-mix(in srgb, var(--destructive) 70%, var(--foreground));
      --dungeon-buff: #7c6bcc;
      --dungeon-buff-fg: #a99adc;
      --dungeon-risk: color-mix(in srgb, var(--accent) 60%, var(--destructive));

      display: grid;
      grid-template-rows: auto 1fr auto;
      height: 100vh;
      height: 100dvh;
      width: 100%;
      overflow: hidden;
      background: var(--background);
      color: var(--foreground);
      font-family: var(--font-sans);
      line-height: 1.5;
      position: relative;
    }
    html.light .dungeon-shell {
      --dungeon-hp: #3a7a3a;
      --dungeon-safe: #4a8a4a;
      --dungeon-safe-fg: #2a6a2a;
      --dungeon-combat-fg: color-mix(in srgb, var(--destructive) 80%, var(--foreground));
      --dungeon-buff: #6a5abc;
      --dungeon-buff-fg: #5a4aac;
    }

    @media (min-width: 1024px) {
      .dungeon-shell {
        grid-template-columns: 1fr 20rem;
        grid-template-rows: auto 1fr auto;
      }
      .dungeon-header { grid-column: 1; }
      .dungeon-stage { grid-column: 1; }
      .dungeon-controls { grid-column: 1; }
      .dungeon-sidebar { grid-column: 2; grid-row: 1 / -1; }
    }

    /* ─── HEADER (HUD) ─── */
    .dungeon-header {
      padding: 0.5rem 1rem;
      border-bottom: 1px solid var(--border);
      background: var(--background);
    }
    @media (min-width: 1024px) {
      .dungeon-header { padding: 0.5rem 1.5rem; }
    }

    .dungeon-header__top {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .dungeon-header__brand { flex-shrink: 0; }
    .dungeon-header__title {
      font-size: 0.875rem;
      line-height: 1;
      margin: 0;
      color: var(--accent);
      text-shadow: 0 0 12px rgba(196, 162, 78, 0.25);
      text-transform: uppercase;
      letter-spacing: 0.15em;
    }
    .dungeon-header__actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      flex-shrink: 0;
      margin-left: auto;
    }

    /* ─── STAT HUD ─── */
    .dungeon-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 0 0.625rem;
      font-size: 0.75rem;
      flex: 1;
      min-width: 0;
    }
    .dungeon-chip {
      display: inline-flex;
      align-items: center;
      gap: 0;
      white-space: nowrap;
      color: var(--muted-foreground);
    }
    .dungeon-chip__k {
      color: var(--muted-foreground);
    }
    .dungeon-chip__k::after {
      content: ':';
      color: var(--muted-foreground);
    }
    .dungeon-chip__v {
      font-weight: 600;
      font-family: 'Courier New', Courier, monospace;
      font-variant-numeric: tabular-nums;
      color: var(--secondary-foreground);
    }
    .dungeon-chip--accent { color: var(--accent); }
    .dungeon-chip--accent .dungeon-chip__v { color: var(--accent); }

    /* stat flash */
    @keyframes stat-flash {
      0% { color: var(--accent); text-shadow: 0 0 6px rgba(196, 162, 78, 0.6); }
      100% { color: var(--secondary-foreground); text-shadow: none; }
    }
    .dungeon-chip--flash .dungeon-chip__v {
      animation: stat-flash 0.6s ease-out;
    }

    /* ─── VITAL BARS ─── */
    .dungeon-vitals {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.375rem;
      margin-top: 0.25rem;
    }
    .dungeon-bar {
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }
    .dungeon-bar__label {
      display: flex;
      align-items: baseline;
      gap: 0.125rem;
      flex-shrink: 0;
      min-width: 3.5rem;
    }
    .dungeon-bar__icon { font-size: 0.75rem; }
    .dungeon-bar__value {
      font-size: 0.75rem;
      font-family: 'Courier New', Courier, monospace;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      transition: color 0.15s;
    }
    .dungeon-bar__unit {
      font-size: 0.75rem;
      color: var(--muted-foreground);
    }
    .dungeon-bar__track {
      flex: 1;
      height: 3px;
      background: var(--border);
      border-radius: 2px;
      overflow: hidden;
    }
    .dungeon-bar__fill {
      height: 100%;
      transition: width 0.15s ease-out, background-color 0.3s;
    }
    .dungeon-bar__fill--timer { background: var(--accent); }
    .dungeon-bar__fill--timer[data-urgent="true"] { background: var(--primary); }
    .dungeon-bar__fill--timer[data-critical="true"] {
      background: var(--destructive);
      animation: bar-pulse 0.5s ease-in-out infinite;
    }
    .dungeon-bar__fill--hp { background: var(--dungeon-hp); }
    .dungeon-bar__fill--hp[data-low="true"] { background: var(--destructive); }

    @keyframes bar-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; }
    }

    /* ─── STAGE ─── */
    .dungeon-stage {
      display: flex;
      flex-direction: column;
      min-height: 0;
      overflow: hidden;
      padding: 0.75rem 1rem;
      gap: 0.375rem;
    }
    @media (min-width: 1024px) {
      .dungeon-stage { padding: 0.75rem 1.5rem; }
    }

    /* ─── ENCOUNTER ─── */
    .dungeon-encounter {
      flex-shrink: 0;
      border-bottom: 1px solid var(--border);
      padding: 0.375rem 0 0.625rem;
    }
    .dungeon-encounter__header {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem;
    }
    .dungeon-encounter__title {
      font-size: 1rem;
      line-height: 1.3;
      margin: 0;
      color: var(--foreground);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .dungeon-encounter__intent {
      font-size: 0.875rem;
      color: var(--destructive);
      font-weight: 600;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .dungeon-encounter__desc {
      font-size: 0.8125rem;
      color: var(--muted-foreground);
      margin-top: 0.125rem;
      line-height: 1.5;
    }
    .dungeon-encounter__mission {
      font-size: 0.75rem;
      color: var(--muted-foreground);
      margin-top: 0.125rem;
    }
    .dungeon-encounter__risk {
      font-size: 0.75rem;
      color: var(--dungeon-risk);
      margin-top: 0;
    }

    /* Transition ASCII */
    .dungeon-transition {
      font-family: 'Courier New', Courier, monospace;
      margin-top: 0.375rem;
      padding: 0.375rem 0;
      font-size: 0.8125rem;
      line-height: 1.5;
      color: var(--accent);
      white-space: pre;
      text-align: center;
      text-shadow: 0 0 8px rgba(196, 162, 78, 0.3);
      animation: transition-glow 1.2s ease-in-out infinite;
    }
    .dungeon-transition.hidden { display: none; }

    @keyframes transition-glow {
      0%, 100% { opacity: 0.6; }
      50% { opacity: 1; }
    }

    /* Quest brief */
    .dungeon-quest-brief {
      margin-top: 0.25rem;
      font-size: 0.75rem;
      color: var(--muted-foreground);
      line-height: 1.4;
    }
    .dungeon-quest-brief__line { margin: 0; }
    .dungeon-quest-brief__line.hidden { display: none; }

    /* ─── EVENT LOG (terminal) ─── */
    .dungeon-log {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.5rem 0;
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
    }
    .dungeon-log__list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    /* log entry stream-in */
    @keyframes log-stream {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .dungeon-log-entry--new {
      animation: log-stream 0.15s ease-out both;
    }

    /* typewriter cursor */
    .dungeon-cursor {
      color: var(--accent);
      animation: cursor-blink 0.53s step-end infinite;
    }
    @keyframes cursor-blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }

    /* choice entrance */
    @keyframes choice-enter {
      from { opacity: 0; transform: translateX(-0.375rem); }
      to { opacity: 1; transform: translateX(0); }
    }
    .dungeon-choice--enter {
      animation: choice-enter 0.15s ease-out both;
    }

    /* text swap */
    @keyframes text-swap {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    .dungeon-text-swap {
      animation: text-swap 0.12s ease-out both;
    }

    /* ─── RUN SUMMARY ─── */
    .dungeon-summary {
      flex-shrink: 0;
      font-size: 0.75rem;
      color: var(--muted-foreground);
      padding: 0.375rem 0;
      border-top: 1px solid var(--border);
      line-height: 1.5;
    }

    /* ─── CONTROLS ─── */
    .dungeon-controls {
      border-top: 1px solid var(--border);
      background: var(--background);
      padding: 0.5rem 1rem;
      display: flex;
      flex-direction: column;
      gap: 0.375rem;
    }
    @media (min-width: 1024px) {
      .dungeon-controls { padding: 0.5rem 1.5rem; }
    }

    /* ─── CHOICE CARDS ─── */
    .dungeon-choices {
      display: grid;
      gap: 0.375rem;
      max-height: 40vh;
      overflow-y: auto;
    }
    @media (min-width: 640px) {
      .dungeon-choices {
        grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      }
    }

    /* Action buttons */
    .dungeon-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.375rem;
      align-items: center;
    }

    /* ─── BUTTON SYSTEM ─── */
    .dungeon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.375rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0.3125rem 0.625rem;
      font-family: inherit;
      font-size: 0.75rem;
      font-weight: 500;
      cursor: pointer;
      transition: border-color 0.1s, background-color 0.1s, color 0.1s;
      background: transparent;
      color: var(--muted-foreground);
      line-height: 1.3;
      white-space: nowrap;
      min-height: 1.5rem;
    }
    .dungeon-btn:hover:not(:disabled) {
      border-color: var(--secondary-foreground);
      color: var(--foreground);
    }
    .dungeon-btn:active:not(:disabled) {
      background: rgba(196, 162, 78, 0.05);
    }
    .dungeon-btn:disabled {
      opacity: 0.25;
      cursor: not-allowed;
    }
    .dungeon-btn:focus-visible {
      outline: 1px solid var(--accent);
      outline-offset: 1px;
    }
    .dungeon-btn--primary {
      background: rgba(196, 162, 78, 0.08);
      color: var(--accent);
      border-color: rgba(196, 162, 78, 0.3);
    }
    .dungeon-btn--primary:hover:not(:disabled) {
      background: rgba(196, 162, 78, 0.15);
      border-color: var(--accent);
    }
    .dungeon-btn--secondary { color: var(--muted-foreground); }
    .dungeon-btn--danger {
      color: var(--destructive);
      border-color: color-mix(in srgb, var(--destructive) 20%, transparent);
    }
    .dungeon-btn--danger:hover:not(:disabled) {
      border-color: var(--destructive);
      color: var(--destructive);
    }
    .dungeon-btn--ghost {
      border-color: var(--border);
      font-size: 0.75rem;
      padding: 0.25rem 0.5rem;
      color: var(--muted-foreground);
    }
    .dungeon-btn--ghost:hover:not(:disabled) {
      color: var(--secondary-foreground);
      border-color: var(--secondary-foreground);
    }
    .dungeon-btn--sm { font-size: 0.75rem; padding: 0.25rem 0.5rem; }
    .dungeon-btn--xs { font-size: 0.75rem; padding: 0.25rem 0.375rem; }
    .dungeon-btn--start { flex: 1; max-width: 14rem; }

    /* Keyboard hints */
    .dungeon-kbd {
      display: none;
      font-size: 0.6875rem;
      font-family: 'Courier New', Courier, monospace;
      padding: 0 0.1875rem;
      color: var(--muted-foreground);
      line-height: 1;
    }
    @media (hover: hover) and (pointer: fine) {
      .dungeon-kbd { display: inline-block; }
    }

    /* ─── SIDEBAR ─── */
    .dungeon-sidebar {
      flex-direction: column;
