---
import Base from '@/layouts/Base.astro';
---

<Base
  title="I'm bored — Alex Alexandrescu"
  description="Text roguelite for tab-side fun"
  hideNav={true}
  hideFooter={true}
  hideWelcomeToast={true}
  mainClass="h-screen"
>
  <div class="h-screen w-screen overflow-hidden bg-background text-foreground">
    <button
      id="sidebar-toggle"
      class="lg:hidden fixed left-1/2 -translate-x-1/2 bottom-3 z-50 rounded-full border border-border bg-card px-4 py-2 text-xs tracking-[0.12em] uppercase text-foreground shadow-apple"
    >
      Show inventory
    </button>

    <div class="grid h-full lg:grid-cols-[22rem_minmax(0,1fr)]">
      <aside
        id="sidebar-panel"
        class="hidden fixed inset-x-3 bottom-14 z-40 max-h-[70vh] overflow-y-auto rounded-3xl border border-border bg-background/95 p-4 shadow-apple-xl backdrop-blur lg:static lg:z-auto lg:block lg:h-full lg:max-h-none lg:overflow-y-auto lg:rounded-none lg:border-0 lg:border-r lg:border-border/70 lg:bg-card/40 lg:p-5 lg:shadow-none"
      >
        <div class="flex items-center justify-between">
          <h2 class="text-sm uppercase tracking-[0.18em] text-muted-foreground">Loadout</h2>
          <button
            id="sidebar-close"
            class="lg:hidden rounded-xl border border-border px-3 py-1.5 text-xs text-muted-foreground"
          >
            Close
          </button>
        </div>

        <article class="mt-4 rounded-2xl border border-border bg-secondary/20 p-4">
          <h3 class="text-xs uppercase tracking-[0.14em] text-muted-foreground">Meta</h3>
          <label class="mt-3 block text-[11px] uppercase tracking-[0.1em] text-muted-foreground" for="meta-alias"
            >Alias</label
          >
          <input
            id="meta-alias"
            class="mt-1 w-full rounded-xl border border-border bg-background/60 px-3 py-2 text-sm text-foreground focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            maxlength="18"
          />
          <div class="mt-3 space-y-1 text-sm text-muted-foreground">
            <p>Shards: <span id="meta-shards" class="text-foreground font-semibold">0</span></p>
            <p>Runs: <span id="meta-runs" class="text-foreground font-semibold">0</span></p>
            <p>Wins: <span id="meta-wins" class="text-foreground font-semibold">0</span></p>
            <p>Best depth: <span id="meta-best-depth" class="text-foreground font-semibold">0</span></p>
          </div>
        </article>

        <article class="mt-4 rounded-2xl border border-border bg-secondary/20 p-4">
          <h3 class="text-xs uppercase tracking-[0.14em] text-muted-foreground">Inventory</h3>
          <div class="mt-3 space-y-3 text-sm text-muted-foreground">
            <div>
              <p class="text-[11px] uppercase tracking-[0.12em]">Collectibles</p>
              <ul id="inventory-collectibles" class="mt-1 space-y-1"></ul>
            </div>
            <div>
              <p class="text-[11px] uppercase tracking-[0.12em]">Consumables</p>
              <ul id="inventory-consumables" class="mt-1 space-y-1"></ul>
            </div>
            <div>
              <p class="text-[11px] uppercase tracking-[0.12em]">Debuffs</p>
              <ul id="inventory-debuffs" class="mt-1 space-y-1"></ul>
            </div>
          </div>
        </article>

        <article class="mt-4 rounded-2xl border border-border bg-secondary/20 p-4">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-xs uppercase tracking-[0.14em] text-muted-foreground">Leaderboard</h3>
            <p id="leaderboard-status" class="text-[10px] uppercase tracking-[0.1em] text-muted-foreground"
              >Local IndexedDB</p
            >
          </div>
          <ul id="leaderboard-list" class="mt-3 space-y-2 text-muted-foreground"></ul>
        </article>

        <article class="mt-4 rounded-2xl border border-border bg-secondary/20 p-4">
          <div class="flex items-center justify-between gap-2">
            <h3 class="text-xs uppercase tracking-[0.14em] text-muted-foreground">
              Balancing telemetry
            </h3>
            <button
              id="telemetry-reset"
              class="rounded-lg border border-border px-2 py-1 text-[10px] uppercase tracking-[0.08em] text-muted-foreground hover:border-primary"
            >
              Reset
            </button>
          </div>
          <div id="telemetry-summary" class="mt-2 space-y-1"></div>
        </article>

        <article class="mt-4 rounded-2xl border border-border bg-secondary/20 p-4">
          <h3 class="text-xs uppercase tracking-[0.14em] text-muted-foreground">Shard Upgrades</h3>
          <div id="upgrade-list" class="mt-3 space-y-3"></div>
        </article>
      </aside>

      <section class="flex h-full min-w-0 flex-col">
        <header class="shrink-0 border-b border-border/70 bg-card/35 px-3 py-2 lg:px-5 lg:py-3">
          <div class="flex items-center justify-between gap-3">
            <div>
              <p class="text-[11px] uppercase tracking-[0.24em] text-primary">Dungeon Console</p>
              <h1 class="font-serif text-2xl text-foreground">I'm bored</h1>
            </div>
            <div class="flex items-center gap-2">
              <p class="hidden md:block text-sm text-muted-foreground">Nyx // Lantern Courier</p>
              <a
                href="/"
                class="rounded-xl border border-border px-3 py-1.5 text-xs uppercase tracking-[0.12em] text-muted-foreground transition-colors hover:border-primary hover:text-foreground focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
              >
                Home
              </a>
            </div>
          </div>

          <div class="mt-2 flex flex-wrap gap-2 text-xs text-muted-foreground">
            <p class="rounded-full border border-border px-3 py-1"
              >Time <span id="stat-time" class="text-foreground font-semibold">60.0</span>s</p
            >
            <p class="rounded-full border border-border px-3 py-1"
              >Depth <span id="stat-depth" class="text-foreground font-semibold">0</span></p
            >
            <p class="rounded-full border border-border px-3 py-1"
              >HP <span id="stat-hp" class="text-foreground font-semibold">0</span></p
            >
            <p class="rounded-full border border-border px-3 py-1"
              >ATK <span id="stat-atk" class="text-foreground font-semibold">0</span></p
            >
            <p class="rounded-full border border-border px-3 py-1"
              >Guard <span id="stat-guard" class="text-foreground font-semibold">0</span></p
            >
            <p class="rounded-full border border-border px-3 py-1"
              >Luck <span id="stat-luck" class="text-foreground font-semibold">0</span></p
            >
            <p class="rounded-full border border-border px-3 py-1"
              >Gold <span id="stat-gold" class="text-foreground font-semibold">0</span></p
            >
            <p class="rounded-full border border-border px-3 py-1"
              >Goal <span id="stat-goal" class="text-foreground font-semibold">Depth 9</span></p
            >
            <p class="rounded-full border border-border px-3 py-1"
              >Relic <span id="stat-relic" class="text-foreground font-semibold">Missing</span></p
            >
          </div>
        </header>

        <div class="min-h-0 flex-1 overflow-hidden px-3 py-2 lg:px-5 lg:py-3">
          <div class="flex h-full flex-col overflow-hidden rounded-2xl border border-border bg-card/35">
            <div class="border-b border-border/70 px-4 py-3">
              <p id="room-title" class="text-xl font-serif text-foreground">Ready for a run</p>
              <p id="room-description" class="mt-1 text-sm text-muted-foreground"
                >Press start to enter the dungeon. Each action spends its listed seconds. Reach depth 9
                before time hits zero for a win.</p
              >
              <p id="room-intent" class="mt-1 text-sm text-foreground"></p>
              <p id="room-mission" class="text-sm text-muted-foreground"></p>
              <p id="room-risk" class="text-sm text-muted-foreground"></p>
              <pre
                id="transition-ascii"
                class="mt-2 hidden whitespace-pre rounded-xl border border-border/60 bg-background/40 px-3 py-2 font-mono text-[11px] leading-4 text-muted-foreground"
              ></pre>
              <div class="mt-2 text-sm space-y-0.5">
                <p id="quest-role" class="text-muted-foreground">You are Nyx, the Lantern Courier.</p>
                <p id="quest-motivation" class="text-muted-foreground"
                  >Motivation: steal the Dawn Relic and prove this run still matters.</p
                >
                <p id="quest-objective" class="text-foreground"
                  >Objective: reach depth 9 before your 60 seconds are spent.</p
                >
              </div>
            </div>

            <div id="event-log-viewport" class="min-h-0 flex-1 overflow-y-auto px-4 py-3">
              <ul id="event-log" class="space-y-2 text-sm text-muted-foreground"></ul>
            </div>
          </div>
        </div>

        <footer class="shrink-0 border-t border-border/70 bg-card/45 px-3 py-2 lg:px-5 lg:py-3">
          <div id="recap-panel" class="hidden mb-2 rounded-xl border border-border bg-secondary/20 px-4 py-2">
            <p id="recap-title" class="text-sm font-semibold text-foreground">Run recap</p>
            <ul id="recap-list" class="mt-1 space-y-1"></ul>
          </div>

          <div
            id="run-summary"
            class="rounded-xl border border-border bg-secondary/20 px-4 py-2 text-sm text-muted-foreground"
          >
            No run yet. Spend shards on upgrades, then start a run.
          </div>

          <div class="mt-2 rounded-xl border border-border bg-secondary/25 p-3">
            <h2 class="text-xs uppercase tracking-[0.18em] text-muted-foreground">Actions</h2>
            <div id="choice-list" class="mt-2 grid gap-2 max-h-[24vh] overflow-y-auto pr-1"></div>
            <div class="mt-2 flex flex-wrap gap-2">
              <button
                id="action-start-run"
                class="rounded-xl border border-border px-3 py-2 text-sm hover:border-primary transition-colors focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
              >
                Start run
              </button>
              <button
                id="action-restart-run"
                class="rounded-xl border border-border px-3 py-2 text-sm hover:border-primary transition-colors focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
              >
                Quick restart
              </button>
              <button
                id="action-abandon-run"
                class="rounded-xl border border-border px-3 py-2 text-sm hover:border-primary transition-colors focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
              >
                Abandon run
              </button>
              <button
                id="action-reset"
                class="rounded-xl border border-border px-3 py-2 text-sm hover:border-primary transition-colors focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
              >
                Reset all progress
              </button>
            </div>
          </div>
        </footer>
      </section>
    </div>
  </div>

  <script>
    import { initBoredDungeonGame } from '@/lib/bored-dungeon/game';

    initBoredDungeonGame();
  </script>
</Base>
