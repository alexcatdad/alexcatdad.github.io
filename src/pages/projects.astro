---
import Base from '@/layouts/Base.astro';
import projectsSnapshot from '@/content/generated/projects.snapshot.json';
import type { ProjectLifecycleState, ProjectsSnapshot } from '@/types/project-snapshot';

const snapshot = projectsSnapshot as ProjectsSnapshot;
const projects = snapshot.items ?? [];

const stateClasses: Record<ProjectLifecycleState, string> = {
  active: 'bg-emerald-500/15 text-emerald-300 border-emerald-500/30',
  maintenance: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
  paused: 'bg-sky-500/15 text-sky-300 border-sky-500/30',
  archived: 'bg-zinc-500/20 text-zinc-300 border-zinc-500/30',
};
---

<Base title="Projects — Alex Alexandrescu" description="Snapshot-driven open source projects">
  <div class="max-w-5xl mx-auto px-6 lg:px-8 py-16">
    <header class="mb-12">
      <p class="text-xs uppercase tracking-[0.3em] text-primary mb-2">Open Source</p>
      <h1 class="text-4xl md:text-5xl font-serif text-foreground text-balance">Projects</h1>
      <p class="font-serif text-muted-foreground mt-3 italic">
        Generated at build time from GitHub repo metadata and per-repo `.project.json` files.
      </p>
      <p class="text-xs text-muted-foreground mt-3">
        Snapshot: {new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(snapshot.generatedAt))} · Included {snapshot.totals.includedRepos} / {snapshot.totals.scannedRepos}
      </p>
    </header>

    {projects.length === 0 ? (
      <div class="rounded-3xl border border-border bg-card/40 p-8">
        <h2 class="text-2xl font-serif text-foreground">No templated projects yet</h2>
        <p class="mt-3 font-serif text-muted-foreground">
          Repositories appear here only when they contain a valid `.project.json` file.
        </p>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {projects.map((project) => (
          <article
            data-project-card
            class="interactive-card overflow-hidden rounded-3xl border border-border bg-card/50 shadow-apple-lg"
          >
            <a href={project.htmlUrl} target="_blank" rel="noopener noreferrer" class="block">
              <img
                src={project.hero}
                alt={`${project.name} preview`}
                width="400"
                height="176"
                loading="lazy"
                class="h-44 w-full object-cover border-b border-border"
              />
            </a>

            <div class="p-5">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <h2 class="text-xl font-semibold text-foreground">{project.name}</h2>
                  {project.language && <p class="text-xs text-muted-foreground mt-1">{project.language}</p>}
                </div>
                <span class={`rounded-full border px-2.5 py-1 text-[11px] uppercase tracking-[0.2em] ${stateClasses[project.state]}`}>
                  {project.state}
                </span>
              </div>

              <p class="mt-4 text-sm font-semibold text-foreground">What</p>
              <p class="text-sm text-muted-foreground mt-1">{project.what}</p>

              <p class="mt-4 text-sm font-semibold text-foreground">Why</p>
              <p class="text-sm text-muted-foreground mt-1">{project.why}</p>

              {project.tags.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="text-xs border border-border px-2 py-0.5 text-muted-foreground">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              <div class="mt-5 flex items-center justify-between text-xs text-muted-foreground">
                <span>{project.stars} stars</span>
                <span>{project.daysSinceCommit}d since commit</span>
              </div>

              <a href={project.htmlUrl} target="_blank" rel="noopener noreferrer" class="link-pulse mt-5 text-sm text-foreground">
                Open repository <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</Base>
