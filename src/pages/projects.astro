---
import Base from '@/layouts/Base.astro';
import { fetchGitHubRepos } from '@/lib/github';

const repos = await fetchGitHubRepos();

const languageColors: Record<string, string> = {
  TypeScript: '#3178c6',
  JavaScript: '#f1e05a',
  Go: '#00ADD8',
  Python: '#3572A5',
  Rust: '#dea584',
  HTML: '#e34c26',
  CSS: '#563d7c',
  Shell: '#89e051',
  Svelte: '#ff3e00',
  Astro: '#bc52ee',
  Swift: '#f05138',
  Ruby: '#701516',
};
---

<Base title="Projects — Alex Alexandrescu" description="Open source repositories and side projects">
  <div class="max-w-5xl mx-auto px-6 lg:px-8 py-16">
    <header class="mb-12">
      <p class="text-xs uppercase tracking-[0.3em] text-primary mb-2">Open Source</p>
      <h1 class="text-4xl md:text-5xl font-serif text-foreground">Projects</h1>
      <p class="font-serif text-muted-foreground mt-3 italic">Public repositories from GitHub, sorted by stars.</p>
    </header>

    {repos.length === 0 ? (
      <p class="font-serif text-muted-foreground italic">No repos found. GitHub API may be rate-limited during build.</p>
    ) : (
      <div class="border-t border-border">
        {repos.map((repo) => (
          <a
            href={repo.html_url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex flex-col md:flex-row md:items-start gap-2 md:gap-8 py-6 border-b border-border transition-colors hover:bg-card/50"
          >
            <div class="md:w-48 shrink-0">
              <h2 class="text-lg font-semibold text-foreground group-hover:text-primary transition-colors">
                {repo.name}
              </h2>
              <div class="flex items-center gap-3 mt-1 text-xs text-muted-foreground">
                {repo.language && (
                  <span class="flex items-center gap-1.5">
                    <span
                      class="inline-block h-2 w-2 rounded-full"
                      style={`background-color: ${languageColors[repo.language] ?? '#8a8378'}`}
                    />
                    {repo.language}
                  </span>
                )}
                {repo.stargazers_count > 0 && (
                  <span>{repo.stargazers_count} &#9733;</span>
                )}
              </div>
            </div>
            <div class="flex-1">
              {repo.description && (
                <p class="font-serif text-sm text-muted-foreground leading-relaxed">{repo.description}</p>
              )}
              {repo.topics && repo.topics.length > 0 && (
                <div class="mt-2 flex flex-wrap gap-2">
                  {repo.topics.slice(0, 5).map((topic) => (
                    <span class="text-xs text-muted-foreground border border-border px-2 py-0.5">
                      {topic}
                    </span>
                  ))}
                </div>
              )}
            </div>
            <span class="hidden md:block text-muted-foreground group-hover:text-primary group-hover:translate-x-1 transition-all text-sm shrink-0">
              &#8594;
            </span>
          </a>
        ))}
      </div>
    )}
  </div>
</Base>
