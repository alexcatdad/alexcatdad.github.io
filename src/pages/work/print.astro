---
import '@/styles/print.css';
import { getEntry } from 'astro:content';
import { splitWorkByEra } from '@/lib/resume-utils';
import { filterResumeByRole, getRoleFromSearchParams } from '@/lib/role-filter';

const entry = await getEntry('resume', 'alex');
const resume = entry?.data;

if (!resume) {
  return Astro.redirect('/');
}

const role = getRoleFromSearchParams(Astro.url.searchParams);
const filtered = filterResumeByRole(resume, role);
const roleLabel =
  role !== 'all'
    ? (filtered._custom?.targetRoles?.[role]?.label ?? role.replace(/-/g, ' '))
    : undefined;

const basics = filtered.basics || {};
const location = basics.location
  ? `${basics.location.city || ''}${basics.location.city && basics.location.countryCode ? ', ' : ''}${basics.location.countryCode || ''}`
  : '';
const linkedInProfile = basics.profiles?.find((p) => p.network === 'LinkedIn');
const displayTitle = roleLabel || basics.label;

const { agenticEra, foundation } = splitWorkByEra(filtered.work ?? []);
const recentFoundation = foundation.filter((w) => {
  const year = w.startDate ? parseInt(w.startDate.split('-')[0]) : 0;
  return year >= 2017;
});
const earlierCareer = foundation.filter((w) => {
  const year = w.startDate ? parseInt(w.startDate.split('-')[0]) : 0;
  return year < 2017;
});

const formatDate = (date?: string) => {
  if (!date) return 'Present';
  const [year, month = '01'] = date.split('-');
  const d = new Date(Number(year), Number(month) - 1 || 0);
  return d.toLocaleString('en', { month: 'short', year: 'numeric' });
};

const skills = (filtered.skills ?? []).slice(0, 4);
const projects = filtered.projects ?? [];
const education = filtered.education ?? [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{basics.name} — {displayTitle || 'Resume'}</title>
  </head>
  <body class="print-body">
    <!-- Page 1: Two-column layout -->
    <header style="margin-bottom: 16px; border-bottom: 1px solid #e5e7eb; padding-bottom: 8px;">
      <h1 style="font-size: 26pt; font-weight: 700; letter-spacing: -0.5px; color: #000; margin: 0;">
        {basics.name}
      </h1>
    </header>

    <div class="print-grid">
      <!-- Left Main Column -->
      <div>
        <!-- Title -->
        {displayTitle && (
          <p style="font-size: 13pt; color: #2563eb; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; margin: 0 0 10px;">
            {displayTitle}
          </p>
        )}

        <!-- Profile -->
        {basics.summary && (
          <section style="margin-bottom: 14px;">
            <h2 class="print-section-title">Profile</h2>
            <p style="font-size: 9.5pt; color: #374151; text-align: justify; line-height: 1.4; margin: 0;">
              {basics.summary}
            </p>
          </section>
        )}

        <!-- Open Source -->
        {projects.length > 0 && (
          <section style="margin-bottom: 14px;">
            <h2 class="print-section-title">Open Source</h2>
            {projects.map((project) => (
              <div class="break-inside-avoid" style="margin-bottom: 10px;">
                <p style="font-size: 10.5pt; font-weight: 700; color: #111827; margin: 0;">
                  {project.name}
                </p>
                {project.description && (
                  <p style="font-size: 9pt; color: #4b5563; margin: 2px 0 3px; line-height: 1.35;">
                    {project.description}
                  </p>
                )}
                {project.highlights && (
                  <ul style="margin: 0; padding-left: 12px;">
                    {project.highlights.slice(0, 2).map((h) => (
                      <li style="font-size: 8.5pt; color: #4b5563; margin-bottom: 1px;">{h}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </section>
        )}

        <!-- Agentic Era Experience -->
        {agenticEra.length > 0 && (
          <section style="margin-bottom: 14px;">
            <h2 class="print-section-title">Experience</h2>
            <p class="print-era-label">Agentic Era</p>
            {agenticEra.map((work) => (
              <div class="break-inside-avoid" style="margin-bottom: 10px;">
                <div style="display: flex; justify-content: space-between; align-items: baseline;">
                  <p style="font-size: 10.5pt; font-weight: 700; color: #111827; margin: 0;">
                    {work.position}
                  </p>
                  <span style="font-size: 8.5pt; color: #6b7280; white-space: nowrap;">
                    {formatDate(work.startDate)} – {formatDate(work.endDate)}
                  </span>
                </div>
                <p style="font-size: 9.5pt; font-weight: 700; color: #374151; margin: 1px 0 2px;">
                  {work.name}
                </p>
                {work.summary && (
                  <p style="font-size: 9pt; color: #4b5563; margin: 0 0 3px; line-height: 1.35;">
                    {work.summary}
                  </p>
                )}
                {work.highlights && (
                  <ul style="margin: 0; padding-left: 12px;">
                    {work.highlights.slice(0, 3).map((h) => (
                      <li style="font-size: 8.5pt; color: #4b5563; margin-bottom: 1px;">{h}</li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </section>
        )}
      </div>

      <!-- Right Sidebar -->
      <div>
        <!-- Contact -->
        <section style="margin-bottom: 14px;">
          <h2 class="print-section-title">Contact</h2>
          {basics.email && <p style="font-size: 9pt; color: #4b5563; margin: 0 0 3px;">{basics.email}</p>}
          {basics.phone && <p style="font-size: 9pt; color: #4b5563; margin: 0 0 3px;">{basics.phone}</p>}
          {location && <p style="font-size: 9pt; color: #4b5563; margin: 0 0 3px;">{location}</p>}
          {basics.url && (
            <p style="margin: 0 0 3px;">
              <a href={basics.url} style="font-size: 9pt; color: #2563eb; text-decoration: none;">GitHub</a>
            </p>
          )}
          {linkedInProfile && (
            <p style="margin: 0 0 3px;">
              <a href={linkedInProfile.url} style="font-size: 9pt; color: #2563eb; text-decoration: none;">LinkedIn</a>
            </p>
          )}
        </section>

        <!-- Skills -->
        {skills.length > 0 && (
          <section style="margin-bottom: 14px;">
            <h2 class="print-section-title">Skills</h2>
            {skills.map((skill) => (
              <div style="margin-bottom: 5px;">
                <p style="font-size: 8pt; font-weight: 700; color: #374151; text-transform: uppercase; letter-spacing: 0.5px; margin: 0 0 2px;">
                  {skill.name}
                </p>
                <div>
                  {(skill.keywords || []).slice(0, 5).map((kw) => (
                    <span class="print-skill-tag">{kw}</span>
                  ))}
                </div>
              </div>
            ))}
          </section>
        )}

        <!-- Education -->
        {education.length > 0 && (
          <section style="margin-bottom: 14px;">
            <h2 class="print-section-title">Education</h2>
            {education.map((edu) => (
              <div style="margin-bottom: 6px;">
                <p style="font-size: 9.5pt; font-weight: 700; color: #111827; margin: 0;">
                  {edu.institution}
                </p>
                <p style="font-size: 8.5pt; color: #4b5563; margin: 0;">
                  {edu.studyType}{edu.area ? ` in ${edu.area}` : ''}
                </p>
                <p style="font-size: 8pt; color: #6b7280; margin: 0;">
                  {formatDate(edu.startDate)} – {formatDate(edu.endDate)}
                </p>
              </div>
            ))}
          </section>
        )}
      </div>
    </div>

    <!-- Page 2: Foundation (full-width) -->
    {(recentFoundation.length > 0 || earlierCareer.length > 0) && (
      <section class="break-before-page">
        <h2 class="print-section-title" style="margin-top: 0;">Foundation</h2>
        <p style="font-size: 8pt; color: #9ca3af; margin: 0 0 10px;">
          Pre-AI roles condensed to transferable value for agentic work
        </p>

        <div class="print-foundation-grid">
          {recentFoundation.map((work) => (
            <div class="break-inside-avoid" style="margin-bottom: 6px;">
              <p style="font-size: 9.5pt; font-weight: 700; color: #111827; margin: 0;">
                {work.position}
              </p>
              <p style="font-size: 8pt; color: #6b7280; margin: 0 0 1px;">
                {work.name} · {formatDate(work.startDate)} – {formatDate(work.endDate)}
              </p>
              {work.highlights && work.highlights.length > 0 && (
                <p style="font-size: 8pt; color: #4b5563; line-height: 1.3; margin: 0;">
                  {work.highlights[0]}
                </p>
              )}
            </div>
          ))}
        </div>

        {earlierCareer.length > 0 && (
          <div style="margin-top: 10px;">
            <p style="font-size: 8pt; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #9ca3af; margin: 0 0 3px;">
              Earlier Career
            </p>
            <p style="font-size: 8.5pt; color: #6b7280; line-height: 1.5; margin: 0;">
              {earlierCareer.map((w) => {
                const year = w.startDate ? w.startDate.split('-')[0] : '';
                return `${w.position} at ${w.name} (${year})`;
              }).join(' · ')}
            </p>
          </div>
        )}
      </section>
    )}

    <!-- Footer (fixed on every printed page) -->
    <div class="print-footer">
      {basics.name} — Generated via Portfolio · {new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
    </div>

    <!-- Auto-print script (skip if ?preview param present) -->
    <script is:inline>
      if (!new URLSearchParams(window.location.search).has('preview')) {
        window.addEventListener('afterprint', () => window.close());
        setTimeout(() => window.print(), 300);
      }
    </script>
  </body>
</html>
