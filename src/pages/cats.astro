---
import Base from '@/layouts/Base.astro';
import catsData from '@/content/cats/cats.json';

interface CatAbility {
  name: string;
  description: string;
}

interface CatStats {
  cuddlePower: number;
  zoomieSpeed: number;
  napMastery: number;
  treatRadar: number;
}

interface Cat {
  id: string;
  name: string;
  type: string;
  tagline: string;
  image: string;
  personality: string;
  ability: CatAbility;
  stats: CatStats;
}

interface CatsData {
  intro: string;
  cats: Cat[];
}

const { intro, cats } = catsData as CatsData;

const statLabels: Record<keyof CatStats, string> = {
  cuddlePower: 'Cuddle Power',
  zoomieSpeed: 'Zoomie Speed',
  napMastery: 'Nap Mastery',
  treatRadar: 'Treat Radar',
};

function getStatColor(value: number): string {
  if (value >= 80) return 'bg-gradient-to-r from-accent to-primary';
  if (value >= 60) return 'bg-gradient-to-r from-primary/80 to-accent/60';
  return 'bg-gradient-to-r from-muted-foreground/60 to-muted-foreground/40';
}

const typeStyles: Record<string, string> = {
  'Lap Cat': 'bg-accent/15 text-accent border-accent/30',
  'Hunter': 'bg-primary/15 text-primary border-primary/30',
  'Indoor': 'bg-sky-500/15 text-sky-300 border-sky-500/30',
  'Mischief Maker': 'bg-amber-500/15 text-amber-300 border-amber-500/30',
};

const statKeys = Object.keys(statLabels) as (keyof CatStats)[];
---

<Base title="My Cats — Alex Alexandrescu" description="The furry coworkers behind the code">
  <div class="max-w-5xl mx-auto px-6 lg:px-8 py-16">
    <header class="mb-12" transition:name="page-header">
      <p class="text-xs uppercase tracking-[0.3em] text-primary mb-2">Furry Coworkers</p>
      <h1 class="text-4xl md:text-5xl font-serif text-foreground text-balance">Meet the team</h1>
      <p class="font-serif text-muted-foreground mt-3 italic max-w-2xl">
        {intro}
      </p>
    </header>

    <div class="grid gap-8 md:grid-cols-2">
      {cats.map((cat) => (
        <article class="cat-card group relative overflow-hidden rounded-3xl border border-border bg-card/50 shadow-apple-lg transition-all duration-500 hover:scale-[1.02]">
          {/* Holographic shimmer overlay */}
          <div
            class="cat-card-shimmer absolute inset-0 z-10 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none"
            aria-hidden="true"
          />

          {/* Hero Image */}
          <div class="relative aspect-[4/3] overflow-hidden bg-muted">
            <img
              src={cat.image}
              alt={`${cat.name}, a ${cat.type.toLowerCase()}`}
              width="600"
              height="450"
              loading="lazy"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-card via-card/40 to-transparent" />

            {/* Name + Type Badge */}
            <div class="absolute bottom-4 left-5 right-5 flex items-end justify-between gap-3">
              <div>
                <h2 class="text-3xl font-display text-foreground tracking-wide drop-shadow-lg">
                  {cat.name.toUpperCase()}
                </h2>
                <p class="text-sm font-serif italic text-muted-foreground mt-0.5">
                  {cat.tagline}
                </p>
              </div>
              <span
                class={`shrink-0 px-3 py-1 text-[10px] uppercase tracking-[0.2em] font-semibold rounded-full border ${typeStyles[cat.type] ?? 'bg-muted text-muted-foreground border-border'}`}
              >
                {cat.type}
              </span>
            </div>
          </div>

          {/* Card Body */}
          <div class="p-6 space-y-5">
            {/* Personality */}
            <p class="text-sm text-muted-foreground leading-relaxed">
              {cat.personality}
            </p>

            {/* Stats */}
            <div class="space-y-3">
              <h3 class="text-xs uppercase tracking-[0.25em] text-primary font-semibold">Stats</h3>

              {statKeys.map((key) => (
                <div class="space-y-1">
                  <div class="flex items-center justify-between text-xs">
                    <span class="text-foreground font-medium">{statLabels[key]}</span>
                    <span class="text-muted-foreground tabular-nums">{cat.stats[key]}</span>
                  </div>
                  <div class="h-2 rounded-full bg-muted/50 overflow-hidden">
                    <div
                      class={`h-full rounded-full ${getStatColor(cat.stats[key])}`}
                      style={`width: ${cat.stats[key]}%`}
                    />
                  </div>
                </div>
              ))}
            </div>

            {/* Special Ability */}
            <div class="rounded-2xl border border-border bg-secondary/30 p-4">
              <h3 class="text-xs uppercase tracking-[0.25em] text-accent font-semibold mb-2">
                Special Ability
              </h3>
              <p class="text-sm font-semibold text-foreground">{cat.ability.name}</p>
              <p class="text-xs text-muted-foreground mt-1 leading-relaxed">
                {cat.ability.description}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Base>

<style>
  .cat-card-shimmer {
    background: linear-gradient(
      135deg,
      transparent 0%,
      color-mix(in srgb, var(--accent) 8%, transparent) 25%,
      color-mix(in srgb, var(--primary) 12%, transparent) 50%,
      color-mix(in srgb, var(--accent) 8%, transparent) 75%,
      transparent 100%
    );
    background-size: 200% 200%;
    animation: shimmer 3s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%, 100% { background-position: 0% 0%; }
    50% { background-position: 100% 100%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-card-shimmer {
      animation: none;
    }
  }
</style>
