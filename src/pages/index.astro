---
import Base from '@/layouts/Base.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('resume', 'alex');
const resume = entry?.data;
const basics = resume?.basics;

const firstName = basics?.name?.split(' ')[0] ?? 'Alex';
const lastName = basics?.name?.split(' ').slice(1).join(' ') ?? 'Alexandrescu';

const sections = [
  {
    num: '01',
    label: 'Commercial Work Experience',
    desc: 'Experience, skills, and delivery highlights',
    href: '/work',
  },
  {
    num: '02',
    label: 'Projects',
    desc: 'Snapshot-powered cards from public repos + project metadata',
    href: '/projects',
  },
  {
    num: '03',
    label: 'Tools',
    desc: 'Preferred stack and built tools used in daily workflows',
    href: '/tools',
  },
  {
    num: '04',
    label: 'Stats',
    desc: 'Daily cached build-time metrics from repository activity',
    href: '/stats',
  },
  {
    num: '05',
    label: "I'm bored",
    desc: 'A cozy idle game you can leave open in a tab',
    href: '/bored',
  },
  {
    num: '06',
    label: 'Contact',
    desc: 'Get in touch via email or LinkedIn',
    href: '/contact',
  },
];
---

<Base title="Alex Alexandrescu — Agentic Engineer">
  {/* ─── KINETIC HERO ─── */}
  <section class="min-h-[75vh] flex flex-col justify-center max-w-5xl mx-auto px-6 lg:px-8 pt-16 pb-8">
    <h1 class="font-display leading-[0.88] tracking-[0.02em] text-foreground text-balance" transition:name="hero-name">
      <span class="clip-reveal">
        <span class="kinetic-line text-[clamp(4.5rem,16vw,13rem)]" style="--delay: 0.15s">
          {firstName.toUpperCase()}
        </span>
      </span>
      <span class="clip-reveal">
        <span class="kinetic-line text-[clamp(3rem,10vw,9rem)]" style="--delay: 0.35s">
          {lastName.toUpperCase()}
        </span>
      </span>
    </h1>

    {basics?.label && (
      <p class="fade-in mt-6 text-xl md:text-2xl font-serif italic text-primary tracking-tight" style="--delay: 0.7s" transition:name="hero-subtitle">
        {basics.label}
      </p>
    )}

    {basics?.summary && (
      <p class="fade-in max-w-xl mt-6 font-serif text-base text-muted-foreground leading-relaxed" style="--delay: 0.9s" transition:name="hero-summary">
        {basics.summary}
      </p>
    )}
  </section>

  {/* ─── EDITORIAL NAV ─── */}
  <section class="max-w-5xl mx-auto px-6 lg:px-8 pb-24">
    <div class="border-t border-border">
      {sections.map((section, i) => (
        <a
          href={section.href}
          class="nav-row group stagger-in"
          style={`--delay: ${1.1 + i * 0.12}s`}
        >
          <div class="flex items-baseline gap-6">
            <span class="text-xs text-muted-foreground font-mono tabular-nums">{section.num}</span>
            <div>
              <span class="text-xl md:text-2xl font-serif text-foreground group-hover:text-primary transition-colors">
                {section.label}
              </span>
              <p class="text-sm text-muted-foreground mt-0.5 hidden md:block">
                {section.desc}
              </p>
            </div>
          </div>
          <span class="nav-row-arrow text-xl" aria-hidden="true">&#8594;</span>
        </a>
      ))}
    </div>
  </section>
</Base>
