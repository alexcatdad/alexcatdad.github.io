---
import Base from '@/layouts/Base.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('resume', 'alex');
const resume = entry?.data;
const basics = resume?.basics;
---

<Base title="Alex Alexandrescu — Full-Stack Architect">
  <div class="max-w-5xl mx-auto px-6 lg:px-8 py-20">
    {/* Hero */}
    <section class="text-center space-y-6">
      {basics?.name && (
        <h1 class="text-5xl md:text-7xl font-extrabold bg-gradient-to-r from-primary via-accent to-primary bg-clip-text text-transparent">
          {basics.name}
        </h1>
      )}
      {basics?.label && (
        <p class="text-xl md:text-2xl text-muted-foreground font-medium">
          {basics.label}
        </p>
      )}
      {basics?.summary && (
        <p class="max-w-2xl mx-auto text-base text-muted-foreground/80 leading-relaxed">
          {basics.summary}
        </p>
      )}
    </section>

    {/* Nav Cards */}
    <nav class="mt-16 grid gap-6 md:grid-cols-3" aria-label="Site sections">
      <a
        href="/cv"
        class="interactive-card rounded-3xl border border-border bg-card/50 p-8 shadow-apple text-center group"
      >
        <div class="flex h-14 w-14 mx-auto items-center justify-center rounded-2xl bg-primary/15 text-primary mb-4">
          <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-foreground mb-2">CV / Resume</h2>
        <p class="text-sm text-muted-foreground">Full professional profile with experience, skills, and projects</p>
      </a>

      <a
        href="/projects"
        class="interactive-card rounded-3xl border border-border bg-card/50 p-8 shadow-apple text-center group"
      >
        <div class="flex h-14 w-14 mx-auto items-center justify-center rounded-2xl bg-accent/15 text-accent mb-4">
          <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-foreground mb-2">Projects</h2>
        <p class="text-sm text-muted-foreground">Open source repos and side projects on GitHub</p>
      </a>

      <a
        href="/contact"
        class="interactive-card rounded-3xl border border-border bg-card/50 p-8 shadow-apple text-center group"
      >
        <div class="flex h-14 w-14 mx-auto items-center justify-center rounded-2xl bg-primary/15 text-primary mb-4">
          <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
          </svg>
        </div>
        <h2 class="text-lg font-semibold text-foreground mb-2">Contact</h2>
        <p class="text-sm text-muted-foreground">Get in touch via email or LinkedIn</p>
      </a>
    </nav>
  </div>
</Base>
