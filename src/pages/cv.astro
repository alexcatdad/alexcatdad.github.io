---
import Base from '@/layouts/Base.astro';
---

<Base title="Redirecting to Work — Alex Alexandrescu">
  <section class="mx-auto max-w-5xl px-6 lg:px-8 py-20 text-center">
    <p class="text-xs uppercase tracking-[0.3em] text-primary">Moved</p>
    <h1 class="mt-3 text-4xl font-serif text-foreground text-balance">Commercial Work Experience</h1>
    <p class="mt-4 font-serif text-muted-foreground">
      The CV route has moved.
      <a class="link-pulse" href="/work">Open /work</a>
    </p>
  </section>

  <script is:inline>
    const target = `/work${window.location.search}${window.location.hash}`;
    window.location.replace(target);
  </script>
</Base>
