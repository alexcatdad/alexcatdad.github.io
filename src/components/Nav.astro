---
import ThemeToggle from '@/components/ThemeToggle.astro';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/work', label: 'Work' },
  { href: '/projects', label: 'Projects' },
  { href: '/tools', label: 'Tools' },
  { href: '/stats', label: 'Stats' },
  { href: '/bored', label: "I'm bored" },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string): boolean {
  if (href === '/work') return pathname.startsWith('/work') || pathname.startsWith('/cv');
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<nav
  id="main-nav"
  aria-label="Primary navigation"
  class="sticky top-0 z-50 border-b border-border bg-background/90 backdrop-blur-sm transition-[background-color,box-shadow,border-color] duration-300"
>
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a
        href="/"
        class="font-display text-2xl tracking-wide text-foreground transition-colors hover:text-primary"
      >
        ALEX A.
      </a>

      {/* Desktop Navigation */}
      <div class="hidden lg:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'relative text-sm font-medium tracking-wide uppercase transition-colors duration-200',
              isActive(link.href)
                ? 'text-foreground'
                : 'text-muted-foreground hover:text-foreground',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
            {isActive(link.href) && (
              <span
                aria-hidden="true"
                class="absolute -bottom-1 left-0 right-0 h-px bg-primary"
              />
            )}
          </a>
        ))}
      </div>

      {/* Desktop Actions */}
      <div class="hidden lg:flex items-center">
        <ThemeToggle />
      </div>

      {/* Mobile Menu Button */}
      <button
        type="button"
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-muted-foreground hover:text-foreground transition-colors"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg aria-hidden="true" class="menu-icon h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg aria-hidden="true" class="close-icon hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile Menu */}
  <div
    id="mobile-menu"
    class="lg:hidden border-t border-border bg-background max-h-0 overflow-hidden opacity-0 transition-[max-height,opacity] duration-300"
  >
    <div class="px-6 py-4 space-y-1">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'block py-3 text-sm font-medium uppercase tracking-wide border-b border-border transition-colors',
            isActive(link.href)
              ? 'text-foreground'
              : 'text-muted-foreground hover:text-foreground',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <div class="pt-3 flex items-center justify-between">
        <span class="text-xs text-muted-foreground uppercase tracking-widest">Theme</span>
        <ThemeToggle />
      </div>
    </div>
  </div>
</nav>

<script>
  function initNav() {
    const nav = document.getElementById('main-nav');
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!nav || !btn || !menu) return;

    const menuIcon = btn.querySelector('.menu-icon') as HTMLElement;
    const closeIcon = btn.querySelector('.close-icon') as HTMLElement;

    // Scroll detection
    const handleScroll = () => {
      if (window.scrollY > 10) {
        nav.classList.add('shadow-apple');
      } else {
        nav.classList.remove('shadow-apple');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Mobile menu toggle
    btn.addEventListener('click', () => {
      const isOpen = menu.classList.contains('max-h-0');
      if (isOpen) {
        menu.classList.remove('max-h-0', 'opacity-0');
        menu.classList.add('max-h-[600px]', 'opacity-100');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      } else {
        menu.classList.add('max-h-0', 'opacity-0');
        menu.classList.remove('max-h-[600px]', 'opacity-100');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
