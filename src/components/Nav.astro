---
import ThemeToggle from '@/components/ThemeToggle.astro';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/cv', label: 'CV' },
  { href: '/projects', label: 'Projects' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string): boolean {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<nav
  id="main-nav"
  aria-label="Primary navigation"
  class="sticky top-0 z-50 border-b border-border transition-all duration-500 glass-subtle shadow-apple"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <a
        href="/"
        class="text-2xl font-extrabold bg-gradient-to-r from-primary to-accent bg-clip-text text-transparent transition-transform duration-200 hover:scale-105"
      >
        Alex A.
      </a>

      {/* Desktop Navigation */}
      <div class="hidden lg:flex items-center gap-1" role="menubar">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              'relative px-5 py-2.5 rounded-2xl font-semibold text-sm transition-all duration-200',
              isActive(link.href)
                ? 'text-primary'
                : 'text-muted-foreground hover:text-foreground',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
            {isActive(link.href) && (
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 -z-10 rounded-2xl glass shadow-apple"
              />
            )}
          </a>
        ))}
      </div>

      {/* Desktop Actions */}
      <div class="hidden lg:flex items-center gap-3">
        <ThemeToggle />
      </div>

      {/* Mobile Menu Button */}
      <button
        type="button"
        id="mobile-menu-btn"
        class="lg:hidden p-3 rounded-2xl glass hover:glass-strong transition-transform duration-200 shadow-apple"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg class="menu-icon h-5 w-5 text-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
        </svg>
        <svg class="close-icon hidden h-5 w-5 text-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  {/* Mobile Menu */}
  <div
    id="mobile-menu"
    class="lg:hidden border-t border-border glass-strong max-h-0 overflow-hidden opacity-0 transition-all duration-300"
  >
    <div class="px-6 py-6 space-y-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            'block w-full text-left px-5 py-3 rounded-2xl font-semibold transition-colors duration-200',
            isActive(link.href)
              ? 'text-primary glass shadow-apple'
              : 'text-muted-foreground hover:text-foreground hover:glass-subtle',
          ]}
          aria-current={isActive(link.href) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4 mt-4 border-t border-border space-y-3">
        <div class="flex items-center justify-between px-5 py-3 glass rounded-2xl">
          <span class="text-sm font-semibold text-muted-foreground">Theme</span>
          <ThemeToggle />
        </div>
      </div>
    </div>
  </div>
</nav>

<script>
  function initNav() {
    const nav = document.getElementById('main-nav');
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    if (!nav || !btn || !menu) return;

    const menuIcon = btn.querySelector('.menu-icon') as HTMLElement;
    const closeIcon = btn.querySelector('.close-icon') as HTMLElement;

    // Scroll detection for glass backdrop
    const handleScroll = () => {
      if (window.scrollY > 10) {
        nav.classList.remove('glass-subtle');
        nav.classList.add('glass-strong', 'shadow-apple-lg');
      } else {
        nav.classList.remove('glass-strong', 'shadow-apple-lg');
        nav.classList.add('glass-subtle');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    // Mobile menu toggle
    btn.addEventListener('click', () => {
      const isOpen = menu.classList.contains('max-h-0');
      if (isOpen) {
        menu.classList.remove('max-h-0', 'opacity-0');
        menu.classList.add('max-h-[600px]', 'opacity-100');
        menuIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
      } else {
        menu.classList.add('max-h-0', 'opacity-0');
        menu.classList.remove('max-h-[600px]', 'opacity-100');
        menuIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      }
    });
  }

  // Run on initial load and on View Transition navigation
  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>
