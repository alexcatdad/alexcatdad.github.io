---
import { encodeEmail } from '@/lib/contact-obfuscation';

interface Props {
  email: string;
}

const { email } = Astro.props;
const encoded = encodeEmail(email);
---

<div class="contact-reveal" data-user={encoded.user} data-domain={encoded.domain}>
  {/* Pre-reveal: mail icon button */}
  <button
    type="button"
    class="reveal-btn flex h-12 w-12 items-center justify-center rounded-full border border-border bg-card transition-transform duration-200 hover:-translate-y-0.5 hover:scale-105 hover:border-primary hover:bg-accent hover:shadow-md"
    aria-label="Reveal email"
  >
    <svg class="w-5 h-5 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
    </svg>
  </button>

  {/* Post-reveal: email + copy button (hidden initially) */}
  <div class="revealed hidden items-center gap-2 rounded-lg border border-border bg-card px-4 py-2 text-sm shadow-lg transition-transform duration-200 hover:-translate-y-0.5">
    <span class="email-text font-mono text-foreground"></span>
    <button
      type="button"
      class="copy-btn px-3 py-1.5 text-xs rounded-md bg-primary text-primary-foreground hover:bg-primary/90 transition-colors duration-200 flex items-center gap-1.5"
    >
      <svg class="copy-icon w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 17.25v3.375c0 .621-.504 1.125-1.125 1.125h-9.75a1.125 1.125 0 0 1-1.125-1.125V7.875c0-.621.504-1.125 1.125-1.125H6.75a9.06 9.06 0 0 1 1.5.124m7.5 10.376h3.375c.621 0 1.125-.504 1.125-1.125V11.25c0-4.46-3.243-8.161-7.5-8.876a9.06 9.06 0 0 0-1.5-.124H9.375c-.621 0-1.125.504-1.125 1.125v3.5m7.5 10.375H9.375a1.125 1.125 0 0 1-1.125-1.125v-9.25m12 6.625v-1.875a3.375 3.375 0 0 0-3.375-3.375h-1.5a1.125 1.125 0 0 1-1.125-1.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H9.75" />
      </svg>
      <span class="copy-label">Copy</span>
    </button>
  </div>
</div>

<script>
  function initContactReveal() {
    document.querySelectorAll('.contact-reveal').forEach((container) => {
      const el = container as HTMLElement;
      const user = el.dataset.user;
      const domain = el.dataset.domain;
      if (!user || !domain) return;

      const revealBtn = el.querySelector('.reveal-btn') as HTMLElement;
      const revealed = el.querySelector('.revealed') as HTMLElement;
      const emailText = el.querySelector('.email-text') as HTMLElement;
      const copyBtn = el.querySelector('.copy-btn') as HTMLElement;
      const copyLabel = el.querySelector('.copy-label') as HTMLElement;
      const copyIcon = el.querySelector('.copy-icon') as HTMLElement;

      const decodedEmail = `${user.split('').reverse().join('')}@${domain.split('').reverse().join('')}`;

      revealBtn?.addEventListener('click', () => {
        emailText.textContent = decodedEmail;
        revealBtn.classList.add('hidden');
        revealed.classList.remove('hidden');
        revealed.classList.add('flex');
      });

      copyBtn?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(decodedEmail);
          copyLabel.textContent = 'Copied!';
          copyBtn.classList.add('bg-primary/10', 'text-primary');
          copyBtn.classList.remove('bg-primary', 'text-primary-foreground');
          setTimeout(() => {
            copyLabel.textContent = 'Copy';
            copyBtn.classList.remove('bg-primary/10', 'text-primary');
            copyBtn.classList.add('bg-primary', 'text-primary-foreground');
          }, 2000);
        } catch {
          console.error('Failed to copy email');
        }
      });
    });
  }

  initContactReveal();
  document.addEventListener('astro:after-swap', initContactReveal);
</script>
