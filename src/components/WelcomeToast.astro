---
---

<div
  id="welcome-toast"
  class="fixed top-20 left-1/2 z-50 -translate-x-1/2 transform-gpu transition-all duration-300 pointer-events-none opacity-0 -translate-y-4"
>
  <div class="border border-border bg-card px-6 py-3 flex items-center gap-4">
    <p class="text-sm text-card-foreground">Welcome — thanks for visiting.</p>
    <button
      type="button"
      id="welcome-toast-close"
      class="text-muted-foreground hover:text-foreground transition-colors text-xs uppercase tracking-widest"
      aria-label="Close"
    >
      Close
    </button>
  </div>
</div>

<script>
  function initWelcomeToast() {
    const toast = document.getElementById('welcome-toast');
    const closeBtn = document.getElementById('welcome-toast-close');
    if (!toast) return;

    const hasVisited = localStorage.getItem('visited');
    if (hasVisited) return;

    localStorage.setItem('visited', 'true');

    requestAnimationFrame(() => {
      toast.classList.remove('opacity-0', '-translate-y-4', 'pointer-events-none');
      toast.classList.add('opacity-100', 'translate-y-0');
    });

    const timer = setTimeout(() => {
      toast.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
      toast.classList.remove('opacity-100', 'translate-y-0');
    }, 3000);

    closeBtn?.addEventListener('click', () => {
      clearTimeout(timer);
      toast.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
      toast.classList.remove('opacity-100', 'translate-y-0');
    });
  }

  initWelcomeToast();
  document.addEventListener('astro:after-swap', initWelcomeToast);
</script>
