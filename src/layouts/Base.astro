---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import ScrollProgress from '@/components/ScrollProgress.astro';
import WelcomeToast from '@/components/WelcomeToast.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Alex Alexandrescu — Full-Stack Architect',
  description = 'Full-stack architect building products from database to deployment. 14+ years shipping production web applications.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <title>{title}</title>
    <ClientRouter />
    {/* Theme script — runs before paint to prevent flash */}
    <script is:inline>
      (function() {
        function applyTheme() {
          var persisted = localStorage.getItem('theme');
          var theme = persisted || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var root = document.documentElement;
          root.classList.remove('light', 'dark');
          root.classList.add(theme);
          root.style.colorScheme = theme;
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    {/* Decorative background */}
    <div class="pointer-events-none fixed inset-0 neo-grid opacity-50" aria-hidden="true"></div>
    <div class="pointer-events-none fixed -top-1/3 left-1/2 h-[780px] w-[780px] -translate-x-1/2 neo-orb" aria-hidden="true"></div>
    <div class="pointer-events-none fixed top-1/4 right-[-10%] h-[420px] w-[420px] neo-orb opacity-70" aria-hidden="true"></div>

    <ScrollProgress />
    <Nav />
    <WelcomeToast />

    <main class="relative z-10">
      <slot />
    </main>

    <Footer />
  </body>
</html>
