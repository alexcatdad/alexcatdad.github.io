---
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import Nav from '@/components/Nav.astro';
import Footer from '@/components/Footer.astro';
import ScrollProgress from '@/components/ScrollProgress.astro';
import TransitionLoader from '@/components/TransitionLoader.astro';
import WelcomeToast from '@/components/WelcomeToast.astro';

interface Props {
  title?: string;
  description?: string;
  hideNav?: boolean;
  hideFooter?: boolean;
  hideWelcomeToast?: boolean;
  mainClass?: string;
}

const {
  title = 'Alex Alexandrescu — Agentic Engineer',
  description = 'Agentic engineer shipping products through human-AI collaboration. 14+ years building production web applications.',
  hideNav = false,
  hideFooter = false,
  hideWelcomeToast = false,
  mainClass = 'relative',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#0d0c0a" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f3ec" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <ClientRouter />
    {/* Theme script — runs before paint to prevent flash */}
    <script is:inline>
      (function() {
        function applyTheme() {
          var persisted = localStorage.getItem('theme');
          var theme = persisted || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var root = document.documentElement;
          root.classList.remove('light', 'dark');
          root.classList.add(theme);
          root.style.colorScheme = theme;
        }
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-[100] focus:bg-primary focus:text-primary-foreground focus:px-4 focus:py-2 focus:rounded-lg focus:text-sm">
      Skip to main content
    </a>
    <ScrollProgress />
    <TransitionLoader />
    {!hideNav && <Nav />}
    {!hideWelcomeToast && <WelcomeToast />}

    <main id="main-content" class={mainClass}>
      <slot />
    </main>

    {!hideFooter && <Footer />}
  </body>
</html>
